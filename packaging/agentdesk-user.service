[Unit]
Description=AgentDesk attention and control daemon
After=network-online.target
Wants=network-online.target

# The release installer substitutes the installed wrapper and environment paths.
[Service]
Type=simple
EnvironmentFile=%h/.config/agentdesk/service.env
ExecStart=%h/.local/lib/agentdesk/agentdesk-service
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/agentdesk

[Install]
WantedBy=default.target
